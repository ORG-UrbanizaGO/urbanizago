{
  "expo": {
    "name": "UrbanizaGO Administrador",
    "slug": "urbanizago-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "urbanizago-admin",
    "android": {
      "package": "com.urbanizago.admin"
    },
    "ios": {
      "bundleIdentifier": "com.urbanizago.admin"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-image-picker",
      "expo-location",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
